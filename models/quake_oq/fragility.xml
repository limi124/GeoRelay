<?xml version="1.0" encoding="utf-8"?>
<!--
  GeoRelay demo community - structural fragility model (HYPOTHETICAL).

  NRML 0.5 fragilityModel, continuous lognormal CDF per limit state
  (<params ls=... mean=... stddev=.../>, shape=logncdf).
  Limit states follow the four-damage-state scheme:
  slight / moderate / extensive / complete.

  The medians/dispersions are order-of-magnitude values taken from the public
  literature and are NOT calibrated to any real building:
    - HAZUS-MH MR5 (FEMA, 2003): generic mid-rise RC frame and low-rise URM
      fragility medians (PGA-based, four damage states).
    - Lagomarsino & Giovinazzi (2006): lognormal typology fragility, beta
      dispersion ~0.6 for the median-based curves.
    - Silva et al. (2014, GEM global fragility review): range check on the
      PGA medians for RC and URM building classes.
  See models/quake_oq/README.md for the full assumption list.
-->
<nrml xmlns="http://openquake.org/xmlns/nrml/0.5">
  <fragilityModel assetCategory="building" id="quake_scenario_damage_v1" lossCategory="structural">
    <description>Hypothetical structural fragility - GeoRelay demo community</description>
    <limitStates>slight moderate extensive complete</limitStates>

    <!-- Mid-rise (8 storey) reinforced concrete frame, moderate seismic detailing. -->
    <fragilityFunction format="continuous" id="RC_8" shape="logncdf">
      <imls imt="PGA" minIML="0.02" maxIML="2.00"/>
      <params ls="slight" mean="0.20" stddev="0.60"/>
      <params ls="moderate" mean="0.33" stddev="0.60"/>
      <params ls="extensive" mean="0.53" stddev="0.60"/>
      <params ls="complete" mean="0.80" stddev="0.65"/>
    </fragilityFunction>

    <!-- Low-rise (5 storey) unreinforced masonry, poor seismic detailing. -->
    <fragilityFunction format="continuous" id="URM_5" shape="logncdf">
      <imls imt="PGA" minIML="0.02" maxIML="2.00"/>
      <params ls="slight" mean="0.10" stddev="0.60"/>
      <params ls="moderate" mean="0.17" stddev="0.60"/>
      <params ls="extensive" mean="0.28" stddev="0.60"/>
      <params ls="complete" mean="0.45" stddev="0.65"/>
    </fragilityFunction>
  </fragilityModel>
</nrml>
