# GeoRelay 配置示例。复制为 .env 后填写，.env 不会进入 Git。
# 所有凭据只在 Node 服务端使用：浏览器只访问同源 /api/*，前端构建产物里不含密钥。

# ── 高德地图（可选）──────────────────────────────────────────────
# 未配置时：前端使用「示例地图 + 示例路线 + 规则模式」，整条建模与演练链路仍可完整验证。
# AMAP_WEB_KEY：高德开放平台「Web端(JS API)」Key，用于浏览器加载 JS API 2.0
AMAP_WEB_KEY=
# AMAP_SECURITY_JS_CODE：JS API 2.0 的安全密钥。由服务端 /api/amap/security 同源下发给前端，
# 不会出现在页面源码或构建产物中。
AMAP_SECURITY_JS_CODE=
# AMAP_REST_KEY：Web 服务 Key，用于周边搜索 / 驾车路线 / 地理编码。
# 留空时回退使用 AMAP_WEB_KEY（同一个 Key 若已开通 Web 服务也可用）。
AMAP_REST_KEY=
# JS API 版本，默认 2.0
AMAP_JS_VERSION=2.0
# 是否允许在前端提示“使用示例数据”（1=允许，0=关闭提示）
AMAP_ALLOW_SAMPLE=1

# ── AI 调度接口（可选）──────────────────────────────────────────
# 未配置时：候选排序与解释由规则生成，界面标注「规则模式」。
# 配置后：AI 只对「规则已生成并通过校验的候选」做比较、解释与排序建议，
# 也能回答「分析当前灾情 / 哪些任务受影响 / 比较可行改派」；
# 规则校验与指挥员确认始终保留，AI 不会自动改派。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 聊天补全路径，默认 /chat/completions（OpenAI 兼容）
AI_CHAT_PATH=/chat/completions
# 超时（毫秒）
AI_TIMEOUT_MS=20000
# 没有凭据时想验证 AI 流程？设为 1 后服务端返回明确标注的「模拟 AI」响应。
# 配合 URL 参数可复现异常分支：?ai=bad-id | expired | timeout | bad-format
AI_MOCK=0

# ── 服务 ───────────────────────────────────────────────────────
# API 服务端口（Vite dev server 会把 /api 代理到这里）
API_PORT=8791
# API 服务监听端口（直接用 npm run start 预览构建产物时用 PORT）
PORT=8791
HOST=127.0.0.1
